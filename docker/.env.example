# Copy to docker/.env and fill in. This file is gitignored; never commit
# a filled-in copy.

# --- Broker login -----------------------------------------------------
# Leave empty to log in once by hand through the noVNC desktop instead.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- API authentication ----------------------------------------------
# Leave empty and the bridge mints an admin key on first boot, printing
# it once to the container log. To set your own, generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 24 characters; the bridge refuses to start with anything less.
BRIDGE_API_KEY=

# Serve market data but reject every order. Recommended while testing.
BRIDGE_READ_ONLY=

# --- Exposure ---------------------------------------------------------
# Host interface the ports publish on. 127.0.0.1 keeps the API reachable
# only from this machine. Change it only when a TLS-terminating reverse
# proxy sits in front, and never together with an empty BRIDGE_API_KEY.
BIND_ADDR=127.0.0.1

# Address of that reverse proxy, so X-Forwarded-For is trusted from it
# and from nowhere else.
BRIDGE_TRUSTED_PROXIES=

# Browser origins allowed to open the portal's WebSockets, comma
# separated, for example https://mt5.example.com. Empty means same origin.
BRIDGE_ALLOWED_ORIGINS=

# Requests per minute per client. 0 disables the limiter.
BRIDGE_RATE_LIMIT=600

# --- Remote desktop ---------------------------------------------------
# Password for the noVNC desktop, minimum 8 characters. Without it the
# desktop stays bound to loopback inside the container.
VNC_PASSWORD=

SCREEN_RESOLUTION=1280x800x24
TZ=UTC
MEMORY_LIMIT=4g
